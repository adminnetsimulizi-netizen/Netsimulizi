display:flex;
align-items:center;
padding:15px 20px;
border-bottom:1px solid var(--border);
}

.logo-area img{
width:48px;
height:48px;
object-fit:contain;
margin-right:10px;
}

.logo-text{
font-size:20px;
font-weight:bold;
color:var(--gold-light);
}

.admin-label{
font-size:11px;
color:var(--muted);
margin-top:3px;
}

.menu{
padding:18px 12px;
}

.menu-title{
font-size:11px;
color:#697180;
text-transform:uppercase;
padding:10px 12px;
font-weight:bold;
}

.menu a{
display:flex;
align-items:center;
gap:12px;
padding:12px;
border-radius:9px;
color:#c5cad3;
font-size:14px;
margin-bottom:4px;
transition:.2s;
}

.menu a:hover{
background:var(--surface-2);
color:#fff;
}

.menu a.active{
background:rgba(229,165,28,.13);
color:var(--gold-light);
}

.menu-icon{
width:22px;
text-align:center;
font-size:17px;
}

/* MAIN */

.main{
margin-left:250px;
width:calc(100% - 250px);
}

.topbar{
height:80px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 28px;
border-bottom:1px solid var(--border);
background:rgba(9,11,16,.96);
position:sticky;
top:0;
z-index:50;
}

.page-title h1{
font-size:22px;
margin-bottom:4px;
}

.page-title p{
font-size:12px;
color:var(--muted);
}

.top-actions{
display:flex;
align-items:center;
gap:12px;
}

.admin-user{
padding:9px 13px;
border:1px solid var(--border);
border-radius:8px;
font-size:13px;
color:#ddd;
}

.logout-btn{
border:1px solid rgba(239,68,68,.35);
background:rgba(239,68,68,.08);
color:#ff7d7d;
padding:9px 13px;
border-radius:8px;
}

/* CONTENT */

.content{
padding:28px;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:16px;
margin-bottom:24px;
}

.stat{
background:var(--surface);
border:1px solid var(--border);
border-radius:12px;
padding:20px;
}

.stat-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:12px;
}

.stat-icon{
width:40px;
height:40px;
border-radius:9px;
display:flex;
align-items:center;
justify-content:center;
background:rgba(229,165,28,.12);
font-size:20px;
}

.stat-number{
font-size:26px;
font-weight:bold;
}

.stat-name{
font-size:12px;
color:var(--muted);
}

/* TOOLBAR */

.toolbar{
background:var(--surface);
border:1px solid var(--border);
border-radius:12px;
padding:16px;
display:flex;
gap:12px;
align-items:center;
margin-bottom:18px;
flex-wrap:wrap;
}

.search-box{
flex:1;
min-width:220px;
position:relative;
}

.search-box input{
width:100%;
background:var(--surface-2);
border:1px solid var(--border);
color:#fff;
padding:11px 13px 11px 40px;
border-radius:8px;
outline:none;
}

.search-box input:focus{
border-color:rgba(229,165,28,.5);
}

.search-icon{
position:absolute;
left:13px;
top:11px;
color:#777;
}

.filter{
background:var(--surface-2);
border:1px solid var(--border);
color:#ddd;
padding:11px 13px;
border-radius:8px;
outline:none;
min-width:160px;
}

.refresh-btn{
padding:11px 15px;
background:var(--gold);
color:#111;
border:0;
border-radius:8px;
font-weight:bold;
}

.refresh-btn:hover{
background:var(--gold-light);
}

/* TABLE */

.table-box{
background:var(--surface);
border:1px solid var(--border);
border-radius:12px;
overflow:hidden;
}

.table-head{
padding:18px 20px;
border-bottom:1px solid var(--border);
display:flex;
justify-content:space-between;
align-items:center;
}

.table-head h2{
font-size:16px;
}

.result-count{
font-size:12px;
color:var(--muted);
}

.table-scroll{
overflow-x:auto;
}

table{
width:100%;
border-collapse:collapse;
min-width:950px;
}

th{
text-align:left;
font-size:11px;
color:#858d9b;
text-transform:uppercase;
letter-spacing:.4px;
padding:14px 16px;
background:rgba(255,255,255,.015);
border-bottom:1px solid var(--border);
}

td{
padding:15px 16px;
border-bottom:1px solid var(--border);
font-size:13px;
vertical-align:middle;
}

tr:last-child td{
border-bottom:0;
}

.story-info{
display:flex;
align-items:center;
gap:12px;
min-width:260px;
}

.story-cover{
width:48px;
height:64px;
border-radius:6px;
object-fit:cover;
background:var(--surface-2);
border:1px solid var(--border);
}

.story-title{
font-weight:bold;
margin-bottom:5px;
max-width:200px;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

.story-description{
font-size:11px;
color:var(--muted);
max-width:200px;
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

.author-name{
color:#ddd;
}

.badge{
display:inline-block;
padding:5px 8px;
border-radius:20px;
font-size:10px;
font-weight:bold;
}

.badge-pending{
background:rgba(245,158,11,.12);
color:#fbbf24;
}

.badge-approved{
background:rgba(34,197,94,.12);
color:#4ade80;
}

.badge-rejected{
background:rgba(239,68,68,.12);
color:#f87171;
