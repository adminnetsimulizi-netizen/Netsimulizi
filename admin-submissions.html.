/* APPROVE */

function approveSubmission(id){

const story =
allSubmissions.find(
s =>
String(s.id || s.story_id) ===
String(id)
);

if(!story){
return;
}

const title =
story.title ||
story.name ||
"story";

const confirmed =
confirm(
`Unataka ku-approve "${title}"?`
);

if(!confirmed){
return;
}

/*
Kwa sasa backend ya approval haijaunganishwa.
Tunabadilisha status upande wa UI.
*/

story.status = "approved";

updateStats();
filterSubmissions();

alert(
"Story imeidhinishwa upande wa UI. Backend approval itaunganishwa baadaye."
);

}

/* REJECT */

function rejectSubmission(id){

const story =
allSubmissions.find(
s =>
String(s.id || s.story_id) ===
String(id)
);

if(!story){
return;
}

const title =
story.title ||
story.name ||
"story";

const confirmed =
confirm(
`Unataka ku-reject "${title}"?`
);

if(!confirmed){
return;
}

/*
Kwa sasa backend rejection haijaunganishwa.
*/

story.status = "rejected";

updateStats();
filterSubmissions();

alert(
"Story imekataliwa upande wa UI. Backend rejection itaunganishwa baadaye."
);

}

