}

.actions{
display:flex;
gap:6px;
flex-wrap:wrap;
}

.action-btn{
border:1px solid var(--border);
background:var(--surface-2);
color:#ddd;
padding:7px 9px;
border-radius:6px;
font-size:11px;
}

.action-btn:hover{
background:#222834;
}

.view-btn{
color:#60a5fa;
}

.approve-btn{
color:#4ade80;
}

.reject-btn{
color:#f87171;
}

/* EMPTY */

.empty{
text-align:center;
padding:55px 20px;
color:var(--muted);
}

.empty-icon{
font-size:40px;
margin-bottom:12px;
}

.loading{
text-align:center;
padding:45px;
color:var(--muted);
}

/* MODAL */

.modal{
display:none;
position:fixed;
inset:0;
background:rgba(0,0,0,.75);
z-index:300;
align-items:center;
justify-content:center;
padding:20px;
}

.modal.show{
display:flex;
}

.modal-box{
width:100%;
max-width:620px;
max-height:90vh;
overflow-y:auto;
background:var(--surface);
border:1px solid var(--border);
border-radius:14px;
}

.modal-header{
padding:18px 20px;
border-bottom:1px solid var(--border);
display:flex;
justify-content:space-between;
align-items:center;
}

.modal-header h2{
font-size:18px;
}

.close-btn{
background:none;
border:0;
color:#aaa;
font-size:24px;
}

.modal-body{
padding:20px;
}

.detail-cover{
width:110px;
height:145px;
object-fit:cover;
border-radius:8px;
display:block;
margin-bottom:18px;
}

.detail-row{
display:grid;
grid-template-columns:140px 1fr;
gap:15px;
padding:11px 0;
border-bottom:1px solid var(--border);
}

.detail-label{
color:var(--muted);
font-size:12px;
}

.detail-value{
font-size:13px;
color:#eee;
word-break:break-word;
}

.modal-actions{
display:flex;
gap:10px;
margin-top:20px;
}

.modal-actions button{
flex:1;
padding:11px;
border-radius:8px;
border:1px solid var(--border);
}

.modal-approve{
background:rgba(34,197,94,.12);
color:#4ade80;
}

.modal-reject{
background:rgba(239,68,68,.12);
color:#f87171;
}

/* MOBILE */

.mobile-menu{
display:none;
background:none;
border:0;
color:#fff;
font-size:25px;
}

.overlay{
display:none;
}

@media(max-width:900px){

.sidebar{
transform:translateX(-100%);
transition:.25s;
}

.sidebar.open{
transform:translateX(0);
}

.main{
margin-left:0;
width:100%;
}

.mobile-menu{
display:block;
}

.overlay.show{
display:block;
position:fixed;
inset:0;
background:rgba(0,0,0,.65);
z-index:90;
}

.stats{
grid-template-columns:repeat(2,1fr);
}

.topbar{
padding:0 16px;
}

.admin-user{
display:none;
}

.content{
padding:18px 14px;
}

}

@media(max-width:520px){

.stats{
gap:10px;
}

.stat{
padding:14px;
}

.stat-number{
font-size:21px;
}

.stat-name{
font-size:10px;
}

.page-title h1{
font-size:18px;
}

.page-title p{
display:none;
}

.toolbar{
padding:12px;
}

.search-box{
min-width:100%;
}

.filter{
flex:1;
min-width:0;
}

.refresh-btn{
width:100%;
}

.detail-row{
grid-template-columns:1fr;
gap:5px;
}

}
</style>

