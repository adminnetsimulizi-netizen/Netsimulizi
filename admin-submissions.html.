<script>

let allSubmissions = [];

/* ADMIN CHECK */

function checkAdmin(){

const user =
JSON.parse(
localStorage.getItem("netsimulizi_user") || "null"
);

if(!user){

window.location.href =
"admin-login.html";

return null;
}

if(user.role !== "admin"){

alert("Huna ruhusa ya kufungua Admin Panel.");

window.location.href =
"index.html";

return null;
}

document.getElementById("adminName").textContent =
user.username ||
user.email ||
"Administrator";

return user;

}

/* LOAD */

async function loadSubmissions(){

const table =
document.getElementById("submissionsTable");

table.innerHTML = `
<tr>
<td colspan="7">
<div class="loading">
Inapakia submissions...
</div>
</td>
</tr>
`;

try{

/*
Tunatumia stories API kwa sasa.
Stories ambazo zina status=pending
zinaonekana kama submissions.
*/

const response =
await fetch("/api/stories");

if(!response.ok){
throw new Error("API error");
}

const data =
await response.json();

let stories = [];

if(Array.isArray(data)){
stories = data;
}
else if(Array.isArray(data.stories)){
stories = data.stories;
}
else if(Array.isArray(data.data)){
stories = data.data;
}

/*
Filter ya submission:
pending / rejected / approved.
*/

allSubmissions =
stories.filter(story => {

const status =
getStatus(story);

return (
status === "pending" ||
status === "approved" ||
status === "rejected"
);

});

updateStats();

filterSubmissions();

}catch(error){

console.error(error);

table.innerHTML = `
<tr>
<td colspan="7">
<div class="empty">
<div class="empty-icon">⚠️</div>
<div>Imeshindikana kupakia submissions.</div>
</div>
</td>
</tr>
`;

}

}

/* STATUS */

function getStatus(story){

let status =
story.status ||
story.approval_status ||
story.publish_status ||
"approved";

status =
String(status).toLowerCase();

if(
status === "published" ||
status === "active" ||
status === "approved"
){
return "approved";
}

if(
status === "pending" ||
status === "waiting" ||
status === "submitted"
){
return "pending";
}

if(
status === "rejected" ||
status === "declined"
){
return "rejected";
}

return status;

}

/* PAID */

function isPaid(story){

return Boolean(
story.is_paid ||
story.paid ||
Number(story.price || 0) > 0
);

}

/* STATS */

function updateStats(){

const total =
allSubmissions.length;

const pending =
allSubmissions.filter(
s => getStatus(s) === "pending"
).length;

const approved =
allSubmissions.filter(
s => getStatus(s) === "approved"
).length;

const rejected =
allSubmissions.filter(
s => getStatus(s) === "rejected"
).length;

document.getElementById(
"totalSubmissions"
).textContent = total;

document.getElementById(
"pendingSubmissions"
).textContent = pending;

document.getElementById(
"approvedSubmissions"
).textContent = approved;

document.getElementById(
"rejectedSubmissions"
).textContent = rejected;

}

/* FILTER */

function filterSubmissions(){

const search =
document.getElementById("searchInput")
.value
.toLowerCase()
.trim();

const status =
document.getElementById("statusFilter")
.value;

const type =
document.getElementById("typeFilter")
.value;

let filtered =
allSubmissions.filter(story => {

const title =
String(
story.title ||
story.name ||
""
).toLowerCase();

const author =
String(
story.author_name ||
story.author ||
""
).toLowerCase();

const matchesSearch =
!search ||
title.includes(search) ||
author.includes(search);

const storyStatus =
getStatus(story);

const matchesStatus =
!status ||
storyStatus === status;

const paid =
isPaid(story);

const matchesType =
!type ||
(type === "paid" && paid) ||
(type === "free" && !paid);

return (
matchesSearch &&
matchesStatus &&
matchesType
);

});

/*
Pending submissions ziwe juu.
*/

if(!status){

filtered.sort((a,b) => {

const order = {
pending:0,
approved:1,
rejected:2
};

return (
(order[getStatus(a)] ?? 9) -
(order[getStatus(b)] ?? 9)
);

});

}

renderSubmissions(filtered);

}

/* RENDER */

function renderSubmissions(stories){

const table =
document.getElementById("submissionsTable");

document.getElementById(
"resultCount"
).textContent =
`${stories.length} submissions`;

if(!stories.length){

table.innerHTML = `
<tr>
<td colspan="7">

<div class="empty">

<div class="empty-icon">
📥
</div>

<div>
Hakuna submissions zilizopatikana.
</div>

</div>

</td>
</tr>
`;

return;

}

table.innerHTML =
stories.map(story => {

const id =
story.id ||
story.story_id ||
"";

const title =
story.title ||
story.name ||
"Untitled Story";

const author =
story.author_name ||
story.author ||
"Unknown Author";

const category =
story.category_name ||
story.category ||
"—";

const language =
story.language ||
story.lang ||
"—";

const status =
getStatus(story);

const paid =
isPaid(story);

const cover =
story.cover_image ||
story.cover ||
story.image ||
"";

let coverHtml;

if(cover){

coverHtml = `
<img
src="${escapeHtml(cover)}"
class="story-cover"
alt=""
onerror="this.style.display='none'"
>
`;

}else{

coverHtml = `
<div
class="story-cover"
style="
display:flex;
align-items:center;
justify-content:center;
font-size:20px
">
📖
</div>
`;

}

return `

<tr>

<td>

<div class="story-info">

${coverHtml}

<div>

<div
class="story-title"
title="${escapeHtml(title)}"
>
${escapeHtml(title)}
</div>

<div
class="story-description"
title="${escapeHtml(story.description || "")}"
>
${escapeHtml(
story.description ||
"Story submission"
)}
</div>

</div>

</div>

</td>

<td>

<span class="author-name">
${escapeHtml(author)}
</span>

</td>

<td>
${escapeHtml(category)}
</td>

<td>
${escapeHtml(language)}
</td>

<td>

<span class="badge ${
paid
? "badge-paid"
